+    const QString sampleDir = qEnvironmentVariable("ZHILI_PPTX_SAMPLE_DIR");
+    if (!sampleDir.isEmpty()) {
+        CHECK(QDir().mkpath(sampleDir));
+        CHECK(exportPptx(doc, QDir(sampleDir).filePath("editable-small.pptx"), &error));
