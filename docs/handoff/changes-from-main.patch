+    CHECK(!blank.findChild<QPushButton *>("symbolApply")->isEnabled());
+    blank.show();
+    QTest::keyClick(blank.findChild<QLineEdit *>("symbolSearch"), Qt::Key_Return);
+    CHECK(blank.isVisible());
+    blank.close();
+    CHECK(blank.result() == QDialog::Rejected);
+
+    SymbolPickerDialog future(nullptr, "future-unrecognized-symbol");
+    CHECK(!future.findChild<QPushButton *>("symbolApply")->isEnabled());
+    future.reject();
+    CHECK(future.selectedSymbolId() == "future-unrecognized-symbol");
+    // Actual dialog geometry, not just a requested resize: large fonts and
+    // 200% scaling used to force the dialog beyond a 400x300 logical screen.
+    const QFont originalFont = app.font();
+    for (int points : {11, 22}) {
+        QFont font = originalFont;
+        font.setPointSize(points);
+        app.setFont(font);
+        SymbolPickerDialog responsive(nullptr, "air-quadcopter");
+        responsive.show();
+        app.processEvents();
+        const QRect screen = QGuiApplication::primaryScreen()->availableGeometry();
+        CHECK(responsive.frameGeometry().width() <= screen.width());
+        CHECK(responsive.frameGeometry().height() <= screen.height());
+        const auto checkActions = [&]() {
+            QList<QRect> buttonRects;
+            for (const char *name : {"symbolApply", "symbolCancel", "symbolRemove"}) {
+                auto *button = responsive.findChild<QPushButton *>(name);
+                if (!button || !button->isVisible() || !button->isEnabled()) return false;
+                const QRect rect(button->mapTo(&responsive, QPoint(0, 0)), button->size());
+                if (!responsive.rect().contains(rect) || button->visibleRegion().isEmpty()) return false;
+                if (rect.height() < button->fontMetrics().height()) return false;
+                for (const QRect &other : buttonRects) if (rect.intersects(other)) return false;
+                buttonRects.append(rect);
+            }
+            return true;
+        };
+        CHECK(checkActions());
+        if (!reviewDir.isEmpty())
+            CHECK(responsive.grab().save(reviewDir + QString("/symbol-picker-screen-%1pt.png").arg(points)));
+        // Exercise expand-shrink-expand, not just compact construction.
+        for (const QSize &requested : {QSize(400, 300), QSize(360, 270), QSize(1000, 800), QSize(400, 300)}) {
+            responsive.resize(requested);
+            app.processEvents();
+            CHECK(responsive.size() == requested);
+            CHECK(checkActions());
+            auto *results = responsive.findChild<QListWidget *>("symbolList");
+            CHECK(results->viewport()->height() >= results->fontMetrics().height() + 20);
+            if (requested.height() <= 300) {
+                CHECK(results->viewMode() == QListView::ListMode);
+                CHECK(!responsive.findChild<QLabel *>("symbolPreview")->isVisible());
+                CHECK(!responsive.findChild<QSlider *>("symbolSize")->isVisible());
+            } else {
+                CHECK(results->viewMode() == QListView::IconMode);
+                CHECK(responsive.findChild<QLabel *>("symbolPreview")->isVisible());
+            }
+        }
+        if (!reviewDir.isEmpty())
+            CHECK(responsive.grab().save(reviewDir + QString("/symbol-picker-400x300-%1pt.png").arg(points)));
+        QTest::mouseClick(responsive.findChild<QPushButton *>("symbolApply"), Qt::LeftButton);
+        CHECK(responsive.result() == QDialog::Accepted && responsive.selectedSymbolId() == "air-quadcopter");
+    }
+    app.setFont(originalFont);
+    qInfo() << "128 unique SVGs rendered at 24/32/64/128 px; 8 categories; search and picker flows passed.";
+    return 0;
+}
diff --git a/tests/template_dialog_test.cpp b/tests/template_dialog_test.cpp
new file mode 100644
index 0000000..7442119
--- /dev/null
+++ b/tests/template_dialog_test.cpp
@@ -0,0 +1,104 @@
+#include "../src/template_dialog.h"
+#include "../src/appearance.h"
+#include <QtWidgets>
+#include <QtTest/QTest>
+
+int main(int argc, char **argv) {
+    QCoreApplication::setAttribute(Qt::AA_EnableHighDpiScaling);
+    QCoreApplication::setAttribute(Qt::AA_UseHighDpiPixmaps);
+    QApplication application(argc, argv);
+    QCoreApplication::setApplicationName(QStringLiteral("ZhiLi template dialog test"));
+    registerEmbeddedFonts();
+    const auto families = embeddedFontFamilies();
+    const int fontPoints = qEnvironmentVariableIntValue("ZHILI_TEMPLATE_FONT_POINTS");
+    if (!families.isEmpty()) application.setFont(QFont(families.first(), fontPoints ? fontPoints : 11));
+    bool passed = true;
+    const auto check = [&](bool condition, const char *what) {
+        if (!condition) { qCritical() << what; passed = false; }
+        return condition;
+    };
+    QTimer::singleShot(0, [&] {
+        auto *dialog = qobject_cast<QDialog *>(QApplication::activeModalWidget());
+        if (!check(dialog, "template dialog visible")) return;
+        auto *search = dialog->findChild<QLineEdit *>(QStringLiteral("templateSearch"));
+        auto *category = dialog->findChild<QComboBox *>(QStringLiteral("templateCategory"));
+        auto *list = dialog->findChild<QListWidget *>(QStringLiteral("templateList"));
+        auto *preview = dialog->findChild<QGraphicsView *>(QStringLiteral("templatePreview"));
+        auto *tree = dialog->findChild<QTreeWidget *>(QStringLiteral("templateOutline"));
+        auto *create = dialog->findChild<QPushButton *>(QStringLiteral("templateCreateButton"));
+        auto *cancel = dialog->findChild<QPushButton *>(QStringLiteral("templateCancelButton"));
+        if (!check(search && category && list && preview && tree && create && cancel, "dialog controls present")) {
+            dialog->reject(); return;
+        }
+        const QRect available = QApplication::primaryScreen()->availableGeometry();
+        check(dialog->width() <= available.width() && dialog->height() <= available.height(),
+              "dialog fits logical screen with selected font");
+        const auto reachable = [dialog](QWidget *widget) {
+            return dialog->rect().contains(QRect(widget->mapTo(dialog, QPoint()), widget->size()));
+        };
+        check(reachable(create) && reachable(cancel), "Create and Cancel stay reachable without scrolling");
+        check(list->count() >= 80 && category->count() == 5, "complete catalog and four categories");
+        check(create->isEnabled() && preview->property("nodeCount").toInt() >= 17, "initial preview valid");
+        check(tree->topLevelItemCount() == 1 && tree->topLevelItem(0)->childCount() >= 4,
+              "readable outline preview available");
+        auto *toggle = dialog->findChild<QPushButton *>(QStringLiteral("templateTogglePreview"));
+        if (toggle) {
+            QTest::mouseClick(toggle, Qt::LeftButton);
+            check(list->isHidden(), "compact preview hides list");
+            check(reachable(create) && reachable(cancel), "compact preview keeps actions reachable");
+            QTest::mouseClick(toggle, Qt::LeftButton);
+            check(!list->isHidden(), "compact preview returns to list");
+        }
+        category->setCurrentIndex(category->findData(QStringLiteral("架构视图")));
+        check(list->count() >= 20, "category filter");
+        search->setText(QStringLiteral("离线 桌面"));
+        check(list->count() == 1, "multi-term Chinese search");
+        check(list->currentItem() && list->currentItem()->data(Qt::UserRole).toString()
+              == QStringLiteral("architecture-offline-desktop"), "correct template selected");
+        const QString screenshot = qEnvironmentVariable("ZHILI_TEMPLATE_SCREENSHOT");
+        if (!screenshot.isEmpty()) {
+            QTest::qWait(100);
+            check(dialog->grab().save(screenshot), "save dialog screenshot");
+            auto *tabs = dialog->findChild<QTabWidget *>(QStringLiteral("templatePreviewTabs"));
+            if (toggle) QTest::mouseClick(toggle, Qt::LeftButton);
+            if (tabs) tabs->setCurrentIndex(1);
+            QTest::qWait(30);
+            check(dialog->grab().save(screenshot + QStringLiteral(".outline.png")), "save outline screenshot");
+            if (toggle) QTest::mouseClick(toggle, Qt::LeftButton);
+        }
+        search->setText(QStringLiteral("no-such-template-987654"));
+        check(list->count() == 0 && !create->isEnabled(), "empty result disables creation");
+        check(preview->property("nodeCount").toInt() == 0 && preview->scene()->items().isEmpty(),
+              "empty result clears old preview");
+        check(tree->topLevelItemCount() == 0, "empty result clears outline");
+        QTest::keyClick(search, Qt::Key_Return);
+        check(dialog->isVisible(), "enter with no selection cannot accept");
+        search->clear();
+        category->setCurrentIndex(0);
+        search->setText(QStringLiteral("  ADR  "));
+        check(list->count() == 1, "case-insensitive trimmed tag search");
+        search->clear();
+        check(list->count() >= 80 && create->isEnabled(), "filter reset restores catalog");
+        QTest::mouseClick(cancel, Qt::LeftButton);
+    });
+    check(zhili::chooseBuiltInTemplate().isEmpty(), "Cancel returns no selection");
+
+    QTimer::singleShot(0, [&] {
+        auto *dialog = qobject_cast<QDialog *>(QApplication::activeModalWidget());
+        if (!check(dialog, "second dialog visible")) return;
+        auto *search = dialog->findChild<QLineEdit *>(QStringLiteral("templateSearch"));
+        auto *create = dialog->findChild<QPushButton *>(QStringLiteral("templateCreateButton"));
+        if (!check(search && create, "second dialog controls")) { dialog->reject(); return; }
+        search->setText(QStringLiteral("activity-workshop"));
+        QTest::mouseClick(create, Qt::LeftButton);
+    });
+    check(zhili::chooseBuiltInTemplate() == QStringLiteral("activity-workshop"), "accept returns catalog ID");
+
+    QTimer::singleShot(0, [&] {
+        auto *dialog = qobject_cast<QDialog *>(QApplication::activeModalWidget());
+        if (!check(dialog, "third dialog visible")) return;
+        QTest::keyClick(dialog, Qt::Key_Escape);
+    });
+    check(zhili::chooseBuiltInTemplate().isEmpty(), "Escape returns no selection");
+    return passed ? 0 : 1;
+}
diff --git a/tests/templates_test.cpp b/tests/templates_test.cpp
new file mode 100644
index 0000000..dfd6401
--- /dev/null
+++ b/tests/templates_test.cpp
@@ -0,0 +1,109 @@
+#include "../src/templates.h"
+#include "../src/layout.h"
+#include <cmath>
+
+namespace {
+QString outline(const Document &document, const QString &id) {
+    const auto &node = document.nodes[id];
+    QString result = '[' + node.text;
+    for (const auto &child : node.children) result += outline(document, child);
+    return result + ']';
+}
+}
+
+int main() {
+#define CHECK(condition) do { if (!(condition)) { qCritical() << __LINE__ << #condition; return 1; } } while (false)
+    const auto entries = zhili::builtInTemplates();
+    CHECK(entries.size() >= 80);
+    QSet<QString> ids, titles, outlines, allNodeIds;
+    QMap<QString, int> categories;
+    int totalNodes = 0;
+    QTemporaryDir temporary;
+    CHECK(temporary.isValid());
+    for (const auto &entry : entries) {
+        CHECK(!entry.id.isEmpty() && !ids.contains(entry.id));
+        CHECK(!entry.title.isEmpty() && !titles.contains(entry.title));
+        CHECK(!entry.description.isEmpty() && !entry.tags.isEmpty());
+        CHECK(entry.nodeCount >= 17);
+        ids.insert(entry.id);
+        titles.insert(entry.title);
+        ++categories[entry.category];
+        Document document;
+        QString error = QStringLiteral("stale error");
+        CHECK(zhili::loadBuiltInTemplate(entry.id, &document, &error));
+        CHECK(error.isEmpty());
+        CHECK(document.nodes.size() == entry.nodeCount);
+        CHECK(document.mindMap == entry.mindMap);
+        CHECK(document.nodes.value(document.root).text == entry.title);
+        CHECK(document.nodes.value(document.root).children.size() >= 4);
+        totalNodes += document.nodes.size();
+        const QString content = outline(document, document.root);
+        CHECK(!outlines.contains(content));
+        outlines.insert(content);
+        for (const auto &node : document.nodes) {
+            CHECK(!node.text.trimmed().isEmpty());
+            CHECK(node.text.size() <= 80);
+            CHECK(!node.collapsed);
+            CHECK(!allNodeIds.contains(node.id));
+            CHECK(!QUuid(node.id).isNull());
+            allNodeIds.insert(node.id);
+        }
+        Document parsed;
+        CHECK(parsed.parse(document.serialize(), &error));
+        CHECK(parsed.serialize() == document.serialize());
+        const QString path = temporary.filePath(entry.id + QStringLiteral(".smap"));
+        CHECK(writeAtomically(path, document.serialize(), &error));
+        CHECK(parsed.readFile(path, &error));
+        CHECK(parsed.serialize() == document.serialize());
+
+        Document another;
+        CHECK(zhili::loadBuiltInTemplate(entry.id, &another, nullptr));
+        CHECK(outline(another, another.root) == content);
+        for (const auto &node : another.nodes) CHECK(!allNodeIds.contains(node.id));
+        another.nodes[another.root].text = QStringLiteral("changed");
+        CHECK(document.nodes.value(document.root).text == entry.title);
+
+        // Both layouts must place all template nodes without overlaps, even
+        // when the template's recommended layout differs from the chosen one.
+        QMap<QString, QSizeF> sizes;
+        for (const auto &node : document.nodes) sizes.insert(node.id, QSizeF(260, 70));
+        for (const bool mindMap : {false, true}) {
+            document.mindMap = mindMap;
+            const auto positions = layoutNodes(document, sizes);
+            CHECK(positions.size() == document.nodes.size());
+            QVector<QRectF> rectangles;
+            for (auto it = positions.cbegin(); it != positions.cend(); ++it) {
+                CHECK(std::isfinite(it->x()) && std::isfinite(it->y()));
+                const QRectF rectangle(*it - QPointF(130, 35), QSizeF(260, 70));
+                for (const auto &previous : rectangles) CHECK(!rectangle.intersects(previous));
+                rectangles.append(rectangle);
+            }
+        }
+    }
+    CHECK(categories.size() == 4);
+    for (const auto &name : {QStringLiteral("活动组织"), QStringLiteral("体系视图"),
+                             QStringLiteral("能力视图"), QStringLiteral("架构视图")})
+        CHECK(categories.value(name) >= 20);
+    CHECK(totalNodes >= 1600);
+
+    Document unchanged;
+    QString error;
+    CHECK(zhili::loadBuiltInTemplate(entries.first().id, &unchanged, &error));
+    const QByteArray before = unchanged.serialize();
+    for (const auto &id : {QString(), QStringLiteral("missing"), QStringLiteral("../catalog.json"),
+                           QStringLiteral(":/templates/activity-kickoff.smap"), QStringLiteral("活动组织")}) {
+        CHECK(!zhili::loadBuiltInTemplate(id, &unchanged, &error));
+        CHECK(!error.isEmpty() && unchanged.serialize() == before);
+        CHECK(!zhili::loadBuiltInTemplate(id, &unchanged, nullptr));
+    }
+    CHECK(!zhili::loadBuiltInTemplate(entries.first().id, nullptr, &error));
+    CHECK(!error.isEmpty());
+    auto changedCatalog = zhili::builtInTemplates();
+    changedCatalog.first().title = QStringLiteral("Changed title");
+    CHECK(zhili::builtInTemplates().first().title == entries.first().title);
+    CHECK(zhili::loadBuiltInTemplate(entries.first().id, &unchanged, &error));
+    CHECK(unchanged.nodes.value(unchanged.root).text == entries.first().title);
+    qInfo() << "Validated" << entries.size() << "templates and" << totalNodes << "nodes in both layouts";
+    return 0;
+#undef CHECK
+}
diff --git a/tools/generate_symbols.py b/tools/generate_symbols.py
